{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Frontend only: React SPA served as Cloudflare Workers Static Assets.
  // The backend always deploys explicitly with worker/wrangler.toml.
  "name": "matchday",
  "compatibility_date": "2026-08-29",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
